# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Postgres + PostGIS) ---
POSTGRES_USER=bhusetu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bhusetu
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bhusetu:change-me@db:5432/bhusetu

# --- Redis / Celery (added in Phase 4) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage / MinIO (added in Phase 1 file upload) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=bhusetu-documents
MINIO_SECURE=false

# --- OCR provider abstraction (added in Phase 2) ---
OCR_PROVIDER=document_ai
GOOGLE_APPLICATION_CREDENTIALS=
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_LOCATION=

# --- Auth / Keycloak (added in Phase 7) ---
KEYCLOAK_URL=
KEYCLOAK_REALM=bhusetu
KEYCLOAK_CLIENT_ID=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
